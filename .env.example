# Local development environment variables
# Copy this file and fill in values. Never commit secrets.

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=hudropower_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Email (leave blank to skip sending in dev)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Hydro Portal <noreply@example.com>

# ERA5
CDS_API_KEY=
CDS_API_URL=

# Security (False in dev)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Logging
DJANGO_LOG_LEVEL=DEBUG
